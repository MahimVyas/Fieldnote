# Server port (the container exposes this port in production)
PORT=3000
# Use a durable volume outside the release directory in production.
FIELDNOTE_DATA_PATH=/var/lib/fieldnote/research.json
# Optional: Fieldnote searches .md and .txt files in this directory when My documents is selected.
FIELDNOTE_DOCUMENTS_PATH=/var/lib/fieldnote/documents
# Optional: URL of a public SearXNG instance (e.g. https://searx.be). Leave empty to use Wikipedia only.
FIELDNOTE_SEARX_URL=
# Optional: URL of a local Ollama server (e.g. http://localhost:11434). Leave empty for template-based brief writing.
FIELDNOTE_OLLAMA_URL=
# AI synthesis via OpenRouter (takes priority when set). Create a key at https://openrouter.ai/keys
# and keep it in a local .env file (git-ignored, never committed).
FIELDNOTE_OPENROUTER_API_KEY=
# OpenRouter model for brief synthesis and study aids. Cheap + reliable JSON default.
FIELDNOTE_OPENROUTER_MODEL=openai/gpt-4o-mini
